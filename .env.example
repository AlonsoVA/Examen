# Copie este archivo a .env si desea cambiar las credenciales de desarrollo.
# docker compose up --build también funciona sin .env: usa estos mismos valores por defecto.

PARCELS_DB_NAME=parcels_db
PARCELS_DB_USER=parcels_user
PARCELS_DB_PASSWORD=parcels_pass

MONITORING_DB_NAME=monitoring_db
MONITORING_DB_USER=monitoring_user
MONITORING_DB_PASSWORD=monitoring_pass

PARCEL_SERVICE_BASE_URL=http://parcel-service:8081
